{
  "name": "@x402cloud/manifests",
  "version": "0.1.0",
  "description": "Single source of truth for x402cloud service manifests — what services exist and how they're priced. Consumed by both the marketplace catalog and each service Worker so prices never drift.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./infer-pricing": {
      "types": "./dist/infer-pricing.d.ts",
      "import": "./dist/infer-pricing.js"
    },
    "./sandbox-pricing": {
      "types": "./dist/sandbox-pricing.d.ts",
      "import": "./dist/sandbox-pricing.js"
    },
    "./scrape-pricing": {
      "types": "./dist/scrape-pricing.d.ts",
      "import": "./dist/scrape-pricing.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@x402cloud/protocol": "workspace:*",
    "@x402cloud/middleware": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x402cloud/x402cloud.git",
    "directory": "packages/manifests"
  },
  "homepage": "https://x402cloud.ai",
  "author": "x402cloud.ai",
  "keywords": ["x402", "manifest", "catalog", "pricing"]
}
