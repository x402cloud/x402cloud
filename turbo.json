{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "acp-seller#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "facilitator-api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "indexer#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "infer#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "status#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
